# cli-tools 域 - 基础 CLI 工具与现代化命令行（通用核心清单，Q11/共识总表）
# 语言管理器本体（mise/uv）在此声明；具体语言版本与默认环境由 bootstrap 编排层负责（mise use -g node@lts）
$schema: https://raw.githubusercontent.com/PowerShell/DSC/main/schemas/2023/08/config/document.json
metadata:
  winget:
    processor:
      identifier: dscv3
resources:

# --- 基础 ---
- type: Microsoft.WinGet/Package
  name: Git
  properties:
    id: Git.Git
    source: winget
    useLatest: true
  metadata:
    description: Git（.gitconfig 由 dotfiles 层管理）

- type: Microsoft.WinGet/Package
  name: VCRedist2015Plus
  properties:
    id: Microsoft.VCRedist.2015+.x64
    source: winget
    useLatest: true
  metadata:
    description: VC++ 2015-2022 x64 运行库（原生工具通用依赖；工单31 史项 vp.exe 0xC0000135 即此因，Stage 3 应用先于 Stage 4 语言工具落位）

# PowerShell 7 不在本域（工单27）：useLatest 升级的 MSI 会强杀 pwsh 宿主内的 bootstrap——
# 生命周期改由入口引导层全权管理（缺失自装 + 5.1 宿主内安全升级），同语言版本走编排层的先例
# Cascadia 字体包已被 winget 目录除名（工单28 后续；.scratch/cascadia-font-source/）——NF 字体换 JetBrainsMono：
# winget 在售 MSI（机内注册，升级/漂移走原生）；WT/VSCode 模板 fontFace 已同步换族
- type: Microsoft.WinGet/Package
  name: JetBrainsMonoNerdFont
  properties:
    id: DEVCOM.JetBrainsMonoNerdFont
    source: winget
    useLatest: true
  metadata:
    description: JetBrainsMono Nerd Font（提示符图标依赖的 NF 字体；Cascadia 包除名后的替代。注册族名为短名：NF=标准 / NFM=单宽图标（终端用）/ NFP=比例）

- type: Microsoft.WinGet/Package
  name: GitHubCLI
  properties:
    id: GitHub.cli
    source: winget
    useLatest: true
  metadata:
    description: GitHub CLI

# --- 提示符与查找 ---
- type: Microsoft.WinGet/Package
  name: Starship
  properties:
    id: Starship.Starship
    source: winget
    useLatest: true
  metadata:
    description: Starship 提示符（三 shell 统一主题引擎；oh-my-posh 由移除清单清掉）

- type: Microsoft.WinGet/Package
  name: Fzf
  properties:
    id: junegunn.fzf
    source: winget
    useLatest: true
  metadata:
    description: fzf 模糊查找

- type: Microsoft.WinGet/Package
  name: Fd
  properties:
    id: sharkdp.fd
    source: winget
    useLatest: true
  metadata:
    description: fd 文件查找（fzf 搜索源）

- type: Microsoft.WinGet/Package
  name: Ripgrep
  properties:
    id: BurntSushi.ripgrep.MSVC
    source: winget
    useLatest: true
  metadata:
    description: ripgrep

- type: Microsoft.WinGet/Package
  name: Zoxide
  properties:
    id: ajeetdsouza.zoxide
    source: winget
    useLatest: true
  metadata:
    description: zoxide 智能跳目录

# --- 数据与构建 ---
- type: Microsoft.WinGet/Package
  name: Bat
  properties:
    id: sharkdp.bat
    source: winget
    useLatest: true
  metadata:
    description: bat（cat 替代）

- type: Microsoft.WinGet/Package
  name: Jq
  properties:
    id: jqlang.jq
    source: winget
    useLatest: true
  metadata:
    description: jq

- type: Microsoft.WinGet/Package
  name: Delta
  properties:
    id: dandavison.delta
    source: winget
    useLatest: true
  metadata:
    description: delta（git diff 美化器，.gitconfig 已挂）

- type: Microsoft.WinGet/Package
  name: Lazygit
  properties:
    id: JesseDuffield.lazygit
    source: winget
    useLatest: true
  metadata:
    description: lazygit（终端 git TUI；ASUS 盘点吸收 2026-10-20，与 delta/fzf 同生态位）

- type: Microsoft.WinGet/Package
  name: Make
  properties:
    id: ezwinports.make
    source: winget
    useLatest: true
  metadata:
    description: GNU make（ezwinports）

- type: Microsoft.WinGet/Package
  name: Uv
  properties:
    id: astral-sh.uv
    source: winget
    useLatest: true
  metadata:
    description: uv——Python 的安装与项目管理器（Python 全权归 uv，直装版由移除清单清掉）

- type: Microsoft.WinGet/Package
  name: Mise
  properties:
    id: jdx.mise
    source: winget
    useLatest: true
  metadata:
    description: mise——多语言版本管理器（Node 等语言运行时归它管；默认环境 node@lts 由 install-languages 设定，vp 退役换轨见 LDC ADR-0016）

# --- 效率 ---
- type: Microsoft.WinGet/Package
  name: Everything
  properties:
    id: voidtools.Everything
    source: winget
    useLatest: true
  metadata:
    description: Everything 文件秒搜

- type: Microsoft.WinGet/Package
  name: PowerToys
  properties:
    id: Microsoft.PowerToys
    source: winget
    useLatest: true
  metadata:
    description: PowerToys（注意：依赖 .NET Desktop 运行时——故移除清单明确保留之）

# --- 浏览器（开发主力）---
- type: Microsoft.WinGet/Package
  name: Chrome
  properties:
    id: Google.Chrome
    source: winget
    useLatest: true
  metadata:
    description: Chrome（开发主力浏览器；Edge 为系统自带，不声明）
