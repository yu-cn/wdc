# ~/.bashrc — Git Bash 交互式配置（WDC 仓库管理；此模板同时是 WSL 侧 bashrc 的蓝本）

# --- PATH ---
# uv 安装的 python/python3/uvx 等可执行文件
export PATH="$HOME/.local/bin:$PATH"
# Windows 应用执行别名 (winget / wt 等)
export PATH="$PATH:$LOCALAPPDATA/Microsoft/WindowsApps"

# --- 历史 ---
HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend cmdhist
PROMPT_COMMAND='history -a'

# --- 编辑器 ---
export EDITOR="code --wait"
export VISUAL="code --wait"

# --- less: 中文友好,退出不清屏 ---
export LESS='-FRXi'

# --- 补全忽略大小写 ---
bind 'set completion-ignore-case on' 2>/dev/null

# --- 别名 ---
alias ll='ls -alF --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
# git 快捷方式,呼应 ~/.gitconfig 中的 alias
alias gs='git st'
alias gl='git lg'
alias gd='git diff'
alias gco='git checkout'
alias serve='python -m http.server 8000'
export COREPACK_NPM_REGISTRY=https://registry.npmmirror.com  # corepack 不读 .npmrc,避免走官方源
export PATH="$PATH:/c/Program Files/PowerShell/7"  # pwsh 7

# --- fzf: Ctrl-R 搜历史 / Ctrl-T 选文件 / Alt-C 跳目录 ---
# 用 fd 做搜索源: 更快, 自动跳过 .git / node_modules
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git --exclude node_modules'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --follow --exclude .git --exclude node_modules'
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border rounded --info=inline'
command -v fzf >/dev/null 2>&1 && eval "$(fzf --bash)"

# --- zoxide: z 命令智能跳目录 ---
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init bash)"

# --- starship 提示符（三 shell 统一主题；二进制缺失时静默跳过）---
command -v starship >/dev/null 2>&1 && eval "$(starship init bash)"

# --- wdc: 一键工具（薄包装；全部逻辑在仓库 scripts/wdc.ps1，工单 20——单一来源防漂移）---
wdc() {
    local repo
    repo=$(head -n 1 "$HOME/.wdc" 2>/dev/null)
    if [ -z "$repo" ] || [ ! -f "$repo/scripts/wdc.ps1" ]; then
        echo "wdc: 未配置仓库路径——先在仓库跑一次 bootstrap（会自动写 ~/.wdc）"; return 1
    fi
    pwsh -NoProfile -File "$repo/scripts/wdc.ps1" "$@"
}

# --- dotfiles 漂移即时提示（工单24，ADR-0015 口径）：开新终端即见，零漂移静默（与 pwsh profile 同款）---
# 信号一「落点漂移」：落点内容 ≠ 模板——bash 无法 dot-source ps1，经一次性 pwsh -NoProfile 读
#   单一来源映射逐项 hash 比对（~300ms 启动换单源，可接受）；WSL 侧无 pwsh 时静默跳过
# 信号二「未提交模板编辑」：git porcelain——「改完记得 commit」红线提醒，非误报（工单24 Comments 定性）
if [ -f "$HOME/.wdc" ]; then
    _wdc_repo=$(head -n 1 "$HOME/.wdc")
    if [ -f "$_wdc_repo/scripts/lib/dotfiles-map.ps1" ]; then
        if command -v pwsh >/dev/null 2>&1; then
            # 仓库路径经环境变量传入（-Command 会把后续参数并进命令串，$args 不可靠）；
            # 须独立 export——`VAR=x var=$(pwsh …)` 前缀赋值不进命令替换子壳（实测 pwsh 读到空值）
            export WDC_REPO="$_wdc_repo"
            _wdc_drift=$(pwsh -NoProfile -NonInteractive -Command '
                $repo = $env:WDC_REPO
                & {
                    . (Join-Path $repo "scripts/lib/dotfiles-map.ps1")
                    $n = 0
                    foreach ($m in (Get-DotfilesMap)) {
                        $src = Join-Path (Join-Path $repo "dotfiles") $m.Source
                        if ((Test-DotfileInSync -Source $src -Target $m.Target) -ne "ok") { $n++ }
                    }
                    $n
                }' 2>/dev/null)
            unset WDC_REPO
            [ "${_wdc_drift:-0}" -gt 0 ] 2>/dev/null && printf '\033[33mwdc: dotfiles 落点漂移 %s 项——重跑 bootstrap 渲染或 wdc triage 分流\033[0m\n' "$_wdc_drift"
        fi
        _wdc_n=$(git --no-optional-locks -C "$_wdc_repo" status --porcelain -- dotfiles/ 2>/dev/null | wc -l)
        [ "${_wdc_n:-0}" -gt 0 ] && printf '\033[33mwdc: dotfiles 模板有 %s 处未提交编辑——commit 收口\033[0m\n' "$_wdc_n"
    fi
    unset _wdc_repo _wdc_drift _wdc_n
fi

