# ~/.gitconfig 模板（WDC 仓库管理，符号链接到 ~\.gitconfig）
# 身份不入仓库：[user] 由每机本地的 ~/.gitidentity 提供（GLOSSARY: 身份文件）
[include]
    path = ~/.gitidentity
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[safe]
	directory = *
[init]
	defaultBranch = main
[core]
	autocrlf = true
	longpaths = true
	editor = code --wait
	quotepath = false
	pager = delta
[fetch]
	prune = true
[pull]
	rebase = false
[diff]
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[push]
	autoSetupRemote = true
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
