# ~/.gitconfig 模板（WDC 仓库管理，WSL 侧；符号链接到 ~\.gitconfig）
# 身份不入仓库：[user] 由每机本地的 ~/.gitidentity 提供（由 bootstrap 从 Windows 侧带过）
[include]
    path = ~/.gitidentity
[safe]
	directory = *
[init]
	defaultBranch = main
[core]
	autocrlf = input
	longpaths = true
	editor = code --wait
	quotepath = false
	pager = delta
[fetch]
	prune = true
[pull]
	rebase = false
[diff]
	algorithm = histogram
[merge]
	conflictstyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[push]
	autoSetupRemote = true
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate -20
	last = log -1 --stat
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
